const updateView = (renderView) => {
    let blockContainer = container.closest('.block-language-dataviewjs');

    // Preserve the container with controls and version text
    const controlsContainer = blockContainer.querySelector('div[style*="display: flex; align-items: center;"]');
    
    // Clear ALL content EXCEPT the controls container
    blockContainer.querySelectorAll(':scope > *:not(:first-child)')
        .forEach(element => element.remove());
    
    // Ensure the controls container remains as the first child
    if (blockContainer.firstChild !== controlsContainer) {
        blockContainer.insertBefore(controlsContainer, blockContainer.firstChild);
    }

    renderView();

    setTimeout(() => {
        // Secondary cleanup after rendering
        blockContainer
            .querySelectorAll('h4')
            .forEach(header => header.remove());
        blockContainer
            .querySelectorAll('dataview-error-box')
            .forEach(errorBox => errorBox.remove());
        const checkboxes = blockContainer
            .querySelectorAll('.dataview.task-list-item-checkbox');
        checkboxes.forEach(checkbox => {
            if (checkbox instanceof HTMLInputElement) {
                checkbox.disabled = true;
            }
        });
    }, 0);
};

// UI -------------------------------------------------------------------------------------------------------
