}
const inactiveProjectView = () => projectView(false);

const deadlineView = (completed = false, taskList = currentTasks, header = "❗ Deadlines") => {
	const hasDeadline = (task) => {
	    if (
		    task.due || 
		    task.scheduled || 
		    /🎯\s*\d{4}-\d{2}-\d{2}/.test(task.text) ||
		    isMarkedCompleted(task)
	    ) {
	        return true;
	    }
	
	    if (task.start) {
	        if (task.due || task.scheduled) {
	            return true;
	        }
	        const today = new Date();
	        today.setHours(0, 0, 0, 0);
	        const startDate = new Date(task.start);
	        startDate.setHours(0, 0, 0, 0);
	        return task.status === " " || startDate >= today;
	    }
	    return false;
	};

	const isTaskAssignedToUser = (task, teamMemberName) => {
		const match = task.text.match(/active-([^\s]+)/);
		return !match || match[1] === teamMemberName;
	};
  
	const getEarliestDate = (task) => {
	    const dateCandidates = [];
	    const nonStartDates = [];
	    if (task.due) nonStartDates.push(task.due);
	    if (task.scheduled) nonStartDates.push(task.scheduled);
	    const targetMatch = task.text.match(/🎯\s*(\d{4}-\d{2}-\d{2})/);
	    if (targetMatch) nonStartDates.push(targetMatch[1]);
	    if (nonStartDates.length > 0) {
	        dateCandidates.push(...nonStartDates);
	    } 
	    else if (task.start) {
	        dateCandidates.push(task.start);
	    }
	    const dateObjects = dateCandidates
	        .map(dateStr => new Date(dateStr))
	        .filter(date => !isNaN(date));
	    if (!dateObjects.length) {
	        return new Date(8640000000000000); 
	    }
	    let earliest = dateObjects[0];
	    for (let i = 1; i < dateObjects.length; i++) {
	        if (dateObjects[i] < earliest) {
	            earliest = dateObjects[i];
	        }
	    }
	    return earliest;
	};

	const getCompletionDate = (task) => {
	    const match = task.text.match(/✅\s(\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01]))/);
	    if (!match) return null;
	    return new Date(match[1]);
	};

	const collectDescendantDeadlineTasks = (task, teamMemberName) => {
		let results = [];
		if (task.children && task.children.length) {
			task.children.forEach(child => {
				if (isTaskAssignedToUser(child, teamMemberName)) {
					if (hasDeadline(child)) {
						results.push({ ...child, children: [], parent: null });
					}
					results = results.concat(collectDescendantDeadlineTasks(child, teamMemberName));
				}
			});
		}
		return results;
	};

	const initialDeadlineTasks = taskList
	    .filter(task => activeForMember(task));

	let allDeadlineTasks = [];
	initialDeadlineTasks.forEach(task => {
		allDeadlineTasks.push({ ...task, children: [], parent: null });
		allDeadlineTasks = allDeadlineTasks.concat(collectDescendantDeadlineTasks(task, teamMemberName));
	});

	const filteredTasks = allDeadlineTasks
        .filter(task => completed ? task.completed : !isCancelled(task) && !isMarkedCompleted(task) && hasDeadline(task))
        .sort((a, b) => completed? getCompletionDate(b) - getCompletionDate(a) : getEarliestDate(a) - getEarliestDate(b));

	if (filteredTasks.length) {
		dv.el("h2", header);
	    dv.taskList(filteredTasks, false);
	}
};
const completedView = () => {
	deadlineView(true, currentTasks, "✅ Completed")
};

// DYNAMICALLY RENDER VIEW ----------------------------------------------------------------------------------
const updateView = (renderView) => {
    let blockContainer = container.closest('.block-language-dataviewjs');

    // Preserve the container with controls and version text
    const controlsContainer = blockContainer.querySelector('div[style*="display: flex; align-items: center;"]');
    
    // Clear ALL content EXCEPT the controls container
    blockContainer.querySelectorAll(':scope > *:not(:first-child)')
        .forEach(element => element.remove());
    
    // Ensure the controls container remains as the first child
    if (blockContainer.firstChild !== controlsContainer) {
        blockContainer.insertBefore(controlsContainer, blockContainer.firstChild);
    }

    renderView();

    setTimeout(() => {
        // Secondary cleanup after rendering
        blockContainer
            .querySelectorAll('h4')
            .forEach(header => header.remove());
        blockContainer
            .querySelectorAll('dataview-error-box')
            .forEach(errorBox => errorBox.remove());
        const checkboxes = blockContainer
            .querySelectorAll('.dataview.task-list-item-checkbox');
        checkboxes.forEach(checkbox => {
            if (checkbox instanceof HTMLInputElement) {
                checkbox.disabled = true;
            }
        });
    }, 0);
};

// UI -------------------------------------------------------------------------------------------------------
