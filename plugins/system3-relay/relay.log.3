## ✏️ Notes


___
```dataviewjs
const version = "2.1.0";
const teamName = "Nueral";
const overrideTeamMemberName = false;

// TASKS ----------------------------------------------------------------------------------------------------
const fullName = overrideTeamMemberName || dv.current().file.name;
const teamMemberName = fullName.toLowerCase().split(" ").join("-");

// Map to store tasks with unique identifiers
const taskMap = new Map();

// Get pages and tasks
let folderPages;
if (teamName) {
    const pathRegex = new RegExp(`^(.*?${teamName})(?:\\/|$)`);
    const match = dv.current().file.path.match(pathRegex);
    const folderPath = match ? match[1] : null;
    folderPages = folderPath ? dv.pages(`"${folderPath}"`) : dv.pages();
} else {
    folderPages = dv.pages();
}

// Process tasks and assign unique IDs
let currentTasks = [];
folderPages.forEach(page => {
    const tasks = page.file.tasks ? page.file.tasks.values : [];
    
    // Create a unique ID for each task based on file path and line number
    tasks.forEach(task => {
        const uniqueId = `${page.file.path}:${task.line}`;
        
        // Store the original file path with the task
        const enhancedTask = {
            ...task,
            _uniqueId: uniqueId,
            _filePath: page.file.path,
            _fileName: page.file.name,
            // Create a parent ID if parent exists
            _parentId: task.parent ? `${page.file.path}:${task.parent}` : null
        };
        
        taskMap.set(uniqueId, enhancedTask);
        currentTasks.push(enhancedTask);
    });
});

// UTILS ----------------------------------------------------------------------------------------------------
const isMarkedCompleted = (task) => /✅\s\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01])/.test(task.text);
const isCancelled = (task) => /❌/.test(task.text);

const activeForMember = (task, status = true) => new RegExp(`${status ? '^(?!.*inactive).*active' : 'inactive'}-${teamMemberName}(?![\\w-])`, 'i').test(task.text) && !isCancelled(task);

const isRelevantToday = (task) => { 
	const today = new Date(); 
	today.setHours(0, 0, 0, 0); 
	const startDate = task.start ? new Date(task.start) : null; 
	const dueDate = task.due ? new Date(task.due) : null; 
	const scheduledDate = task.scheduled ? new Date(task.scheduled) : null; 
	if (task.completed || task.status === "-") return false; 
	return !startDate && !scheduledDate || (!startDate || startDate <= today) && (!scheduledDate || scheduledDate <= today);
}

// VIEWS ----------------------------------------------------------------------------------------------------
const projectView = (status = true) => {
    // Helper function to identify task types
    function getTaskType(task) {
        if (!task) return null;
        if (task.text.includes("🎖️")) return "initiative";
        if (task.text.includes("🏆")) return "epic";
        if (task.text.includes("📝")) return "story";
        return "task";
    }
    
    // Helper function to find the highest parent initiative - using task map instead of array find
    function getInitiative(task) {
        if (!task || !task._parentId) return null;
        let parent = taskMap.get(task._parentId);
        if (!parent) return null;
        if (parent.text.includes("🎖️")) return parent;
        return getInitiative(parent);
    }
    
    // Helper function to find any initiative or epic parent (for tasks)
    function getInitiativeOrEpic(task) {
        if (!task || !task._parentId) return null;
        let parent = taskMap.get(task._parentId);
        if (!parent) return null;
        if (parent.text.includes("🎖️") || parent.text.includes("🏆")) return parent;
        return getInitiativeOrEpic(parent);
    }
    
    // Helper function to find any structured parent (initiative, epic, or story)
    function getStructuredParent(task) {
        if (!task || !task._parentId) return null;
        let parent = taskMap.get(task._parentId);
        if (!parent) return null;
        if (parent.text.includes("🎖️") || parent.text.includes("🏆") || parent.text.includes("📝")) return parent;
        return getStructuredParent(parent);
    }
    
    // Helper function to check if a task is directly assigned to user
    function isDirectlyAssigned(task) {
        return activeForMember(task, status) && !task.completed && isRelevantToday(task) && !isCancelled(task);
    }
    
    // Helper function to check if a task is assigned to any user
    function isAssignedToAnyUser(task) {
        return task && /active-[a-zA-Z0-9-]+/.test(task.text);
    }
    
    // Helper function to get path from a task to its ancestor
    function getPathToAncestor(task, ancestorId) {
        let result = [];
        let current = task;
        
        let visited = new Set();
        
        while (current && current._uniqueId !== ancestorId && !visited.has(current._uniqueId)) {
            visited.add(current._uniqueId);
            result.push(current);
            
            if (!current._parentId) break;
            
            current = taskMap.get(current._parentId);
        }

        if (current && current._uniqueId === ancestorId) {
            result.push(current);
        }
        
        return result.reverse();
    }
    
    // Helper function to build a task hierarchy from a path
    function buildHierarchyFromPath(path) {
        if (!path || path.length === 0) return null;
        
        // Start with the highest ancestor
        let rootTask = { ...path[0], children: [] };
        let current = rootTask;
        
        // Build the hierarchy
        for (let i = 1; i < path.length; i++) {
            const childTask = { ...path[i], children: [] };
            current.children = [childTask];
            current = childTask;
        }
        
        return rootTask;
    }
    
    // Recursive function to check if a task is on path to an assigned item
    function processTaskHierarchy(task, assignedItems) {
        if (!task) return null;
        
        if (assignedItems.some(t => t._uniqueId === task._uniqueId)) {
            return { ...task, children: [] };
        }
        
        const childrenIds = currentTasks
            .filter(t => t._parentId === task._uniqueId)
            .map(t => t._uniqueId);
        
        const children = childrenIds.map(id => taskMap.get(id));
        
        const processedChildren = children
            .map(child => processTaskHierarchy(child, assignedItems))
            .filter(result => result !== null);
        
        if (processedChildren.length === 0) {
            return null;
        }
        
        return { ...task, children: processedChildren };
    }

    // Get responsibility tasks (status "O") assigned to current user
	const responsibilityRoots = currentTasks.filter(task =>
	    task.status === "O" &&
	    !task.completed &&
	    isRelevantToday(task) &&
	    !isCancelled(task) &&
	    !task.text.includes("🎖️") &&
	    !task.text.includes("🏆") &&
	    !task.text.includes("📝")
	);
	
	function buildResponsibilityTree(task) {
	    const allowedMarkers    = ["🚀","📦","⚡","⭐","💝","🔁"];
	    const disallowedMarkers = ["❌","🛠️","📂"];
	
	    if (disallowedMarkers.some(m => task.text.includes(m))) {
	        return null;
	    }
	
	const rawChildren = Array.isArray(task.children) ? task.children : [];
	const children = rawChildren
	  .map(buildResponsibilityTree)
	  .filter(c => c !== null);
	
	    if (task.task === false) {
	        return children.length > 0
	            ? { ...task, children }
	            : null;
	    }
	
	    const hasAllowed   = allowedMarkers.some(m => task.text.includes(m));
	    const assignedToMe = activeForMember(task, status);
	    if (!hasAllowed && children.length === 0 && !assignedToMe) {
	        return null;
	    }
	
	    return { ...task, children };
	}
	
	const rawTrees = responsibilityRoots
	    .map(buildResponsibilityTree)
	    .filter(tree => tree !== null);
	
	function pruneResponsibilities(node, inherited = false) {
	  const m             = node.text.match(/active-([^"\s]+)/);
	  const assignedToMe  = m?.[1] === teamMemberName;
	
	  const isInherited = inherited || assignedToMe;
	
	  const children = (node.children || [])
	    .map(child => pruneResponsibilities(child, isInherited))
	    .filter(Boolean);
	
	  if (isInherited || children.length > 0) {
	    return { ...node, children };
	  }
	
	  return null;
	}
	
	let responsibilityTasks = rawTrees
	    .map(tree => pruneResponsibilities(tree))
	    .filter(tree => tree !== null)
	    .filter(tree => {
	        const m    = tree.text.match(/active-([^"\s]+)/);
	        const isMe = m?.[1] === teamMemberName;
	        return isMe || (tree.children?.length > 0);
	    });

	// Strip out any fake‐header (task:false) and lift its children up:
	function stripFakeHeaders(nodes) {
	  const out = [];
	  for (const node of nodes) {
	    if (node.task === false) {
	      // before we lift them up, re-parent each child
	      for (const child of node.children || []) {
	        child._parentId = node._parentId;
	        child.parent    = node.parent;
	      }
	      // recurse into its children
	      out.push(...stripFakeHeaders(node.children || []));
	    }
	    else {
	      // real task → descend into its children
	      out.push({
	        ...node,
	        children: stripFakeHeaders(node.children || [])
	      });
	    }
	  }
	  return out;
	}
	
	// now flatten the headers out of your tree:
	responsibilityTasks = stripFakeHeaders(responsibilityTasks);

    // Get regular tasks (no special markers) assigned to current user, excluding responsibility tasks
    let receivedTasks = currentTasks
        .filter(task => isDirectlyAssigned(task) &&
            !task.text.includes("🎖️") &&
            !task.text.includes("🏆") &&
            !task.text.includes("📝") &&
            task.status !== "O");  // Exclude tasks with status "O"
    
    // Find initiatives that have tasks assigned to the user
    let receivedTaskInitiatives = Array.from(new Set(
        receivedTasks
            .map(task => getInitiative(task))
            .filter(initiative => initiative !== null)
            .map(initiative => initiative._uniqueId)))
            .map(uniqueId => taskMap.get(uniqueId))
            .filter(task => task !== undefined);
    
    // For tasks with no initiative parent, find the highest epic parent
    let receivedTaskEpics = Array.from(new Set(
        receivedTasks
            .filter(task => !getInitiative(task)) // Tasks with no initiative parent
            .map(task => getInitiativeOrEpic(task))
            .filter(parent => parent !== null && parent.text.includes("🏆"))
            .map(epic => epic._uniqueId)))
            .map(uniqueId => taskMap.get(uniqueId))
            .filter(task => task !== undefined);
    
    // For tasks with no initiative or epic parent, find story parents
    let receivedTaskStories = Array.from(new Set(
        receivedTasks
            .filter(task => !getInitiative(task) && !getInitiativeOrEpic(task)) // No initiative or epic parent
            .map(task => getStructuredParent(task))
            .filter(parent => parent !== null && parent.text.includes("📝"))
            .map(story => story._uniqueId)))
            .map(uniqueId => taskMap.get(uniqueId))
            .filter(task => task !== undefined);
    
    // Handle non-structured task hierarchies differently
    let nonStructuredTasks = receivedTasks
        .filter(task => !getInitiative(task) && !getInitiativeOrEpic(task) && !getStructuredParent(task));
    
    // Process task hierarchies starting from initiatives
    let prunedInitiativeTasks = receivedTaskInitiatives
        .map(initiative => processTaskHierarchy(initiative, receivedTasks))
        .filter(result => result !== null);
    
    // Process task hierarchies starting from epics (for tasks with no initiative)
    let prunedEpicTasks = receivedTaskEpics
        .map(epic => processTaskHierarchy(epic, receivedTasks))
        .filter(result => result !== null);
    
    // Process task hierarchies starting from stories (for tasks with no initiative or epic)
    let prunedStoryTasks = receivedTaskStories
        .map(story => processTaskHierarchy(story, receivedTasks))
        .filter(result => result !== null);
    
    // For non-structured tasks
    let prunedNonStructuredTasks = [];
    
    // Process each non-structured task
    nonStructuredTasks.forEach(task => {
        // Find the path upwards to find any assigned parent
        let current = task;
        let highestAssignedParent = null;
        
        let visited = new Set();
        
        // Traverse up the task hierarchy
        while (current && current._parentId && !visited.has(current._parentId)) {
            visited.add(current._parentId);
            const parent = taskMap.get(current._parentId);
            
            // Stop at structured parents
            if (!parent || parent.text.includes("🎖️") || parent.text.includes("🏆") || parent.text.includes("📝")) {
                break;
            }
            
            // If found an assigned parent, update highestAssignedParent
            if (isAssignedToAnyUser(parent)) {
                highestAssignedParent = parent;
            }
            
            current = parent;
        }
        
        if (highestAssignedParent) {
            const path = getPathToAncestor(task, highestAssignedParent._uniqueId);
            
            const hierarchy = buildHierarchyFromPath(path);
            
            if (hierarchy) {
                prunedNonStructuredTasks.push(hierarchy);
            }
        } else {
            prunedNonStructuredTasks.push({...task, children: []});
        }
    });
    
    // Remove duplicates by comparing unique IDs
    prunedNonStructuredTasks = Array.from(
        new Map(prunedNonStructuredTasks.map(item => [item._uniqueId, item])).values()
    );
    
    // Combine all task hierarchies
    let prunedTasks = [...prunedInitiativeTasks, ...prunedEpicTasks, ...prunedStoryTasks, ...prunedNonStructuredTasks];
    
    // Get stories directly assigned to user
    let receivedStories = currentTasks
        .filter(task => task.text.includes("📝") && isDirectlyAssigned(task));
    
    // Find initiatives that have stories assigned to the user
    let receivedStoryInitiatives = Array.from(new Set(
        receivedStories
            .map(story => getInitiative(story))
            .filter(initiative => initiative !== null)
            .map(initiative => initiative._uniqueId)))
            .map(uniqueId => taskMap.get(uniqueId))
            .filter(task => task !== undefined);
    
    // For stories with no initiative parent, find epic parents
    let receivedStoryEpics = Array.from(new Set(
        receivedStories
            .filter(story => !getInitiative(story)) // Stories with no initiative parent
            .map(story => getInitiativeOrEpic(story))
            .filter(parent => parent !== null && parent.text.includes("🏆"))
            .map(epic => epic._uniqueId)))
            .map(uniqueId => taskMap.get(uniqueId))
            .filter(task => task !== undefined);
    
    // For stories with no initiative or epic parent, include them directly
    let standaloneStories = receivedStories
        .filter(story => !getInitiative(story) && !getInitiativeOrEpic(story));
    
    // Process story hierarchies starting from initiatives
    let prunedInitiativeStories = receivedStoryInitiatives
        .map(initiative => processTaskHierarchy(initiative, receivedStories))
        .filter(result => result !== null);
    
    // Process story hierarchies starting from epics (for stories with no initiative)
    let prunedEpicStories = receivedStoryEpics
        .map(epic => processTaskHierarchy(epic, receivedStories))
        .filter(result => result !== null);
    
    // Combine all story hierarchies
    let prunedStories = [...prunedInitiativeStories, ...prunedEpicStories];
    
    // Add standalone stories
    standaloneStories.forEach(story => {
        prunedStories.push({...story, children: []});
    });
    
    // Get epics directly assigned to user
    let receivedEpics = currentTasks
        .filter(task => task.text.includes("🏆") && isDirectlyAssigned(task));
    
    // Find initiatives that have epics assigned to the user
    let receivedEpicInitiatives = Array.from(new Set(
        receivedEpics
            .map(epic => getInitiative(epic))
            .filter(initiative => initiative !== null)
            .map(initiative => initiative._uniqueId)))
            .map(uniqueId => taskMap.get(uniqueId))
            .filter(task => task !== undefined);
    
    // For epics with no initiative parent, include them directly
    let standaloneEpics = receivedEpics
        .filter(epic => !getInitiative(epic));
    
    // Process epic hierarchies starting from initiatives
    let prunedEpicsWithInitiatives = receivedEpicInitiatives
        .map(initiative => processTaskHierarchy(initiative, receivedEpics))
        .filter(result => result !== null);
    
    // Combine all epic hierarchies
    let prunedEpics = [...prunedEpicsWithInitiatives];
    
    // Add standalone epics
    standaloneEpics.forEach(epic => {
        prunedEpics.push({...epic, children: []});
    });
    
    const createHeader = (text) => ({
        id: text + '-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5),
        symbol: "-",     
        text: `${text}`,     
        children: [],   
        task: false,   
        annotated: false,   
        subtasks: [],   
        real: false,   
        status: "O",   
        checked: true,   
        completed: false,   
        fullyCompleted: false,
    });
    
    const categorizeEpic = (epic) => {
        if (epic.text.match(/class="(?:in)?active-(?!${teamMemberName})[^"]*"/)) return "delegated";
        if (epic.text.includes(">⛔")) return "blocked";
        if (epic.text.includes(">⌛")) return "waiting";
        if (epic.text.includes(">🕒")) return "pending";
        if (epic.status === "/") return "inProgress";
        if (epic.status === " ") return "todo";
        return "other";
    };
    
    let ownInitiatives = currentTasks
        .filter(task => task.text && task.text.includes("🎖️"))
        .map((initiative) => {
            if (!initiative.children) {
                initiative.children = [];
                return initiative;
            }
            
            // Find children using the _uniqueId
            const epicIds = currentTasks
                .filter(t => t._parentId === initiative._uniqueId)
                .map(t => t._uniqueId);
            
            const epics = epicIds
                .map(id => taskMap.get(id))
                .filter(epic => epic && !epic.completed);
                
            const categorizedEpics = {
                inProgress: [],
                todo: [],
                blocked: [],
                waiting: [],
                pending: [],
                delegated: [],
            };
        
            epics.forEach((epic) => {
                const category = categorizeEpic(epic);
                if (category in categorizedEpics) {
                    categorizedEpics[category].push({ ...epic, children: [] });
                }
            });
        
            const nonEmptyCategories = Object.values(categorizedEpics).filter(
                (array) => array.length > 0
            ).length;
        
            const sortedChildren = [];
            const categories = [
                "inProgress",
                "todo",
                "blocked",
                "waiting",
                "pending",
                "delegated",
            ];
        
            categories.forEach((category) => {
                if (categorizedEpics[category].length > 0) {
                    if (nonEmptyCategories > 1) {
                        sortedChildren.push(createHeader("✏️"));
                    }
                    sortedChildren.push(...categorizedEpics[category]);
                }
            });
        
            return {
                ...initiative,
                children: sortedChildren,
            };
        })
        .filter(
            (task) =>
                task.text.includes("🎖️") &&
                activeForMember(task, status) &&
                !task.completed &&
                isRelevantToday(task)
        );
        
        if (prunedTasks.length) {
            dv.el("h2", "🔨 Tasks");
            dv.taskList(prunedTasks);
        }
        if (prunedStories.length) {
            dv.el("h2", "📝 Stories");
            dv.taskList(prunedStories);
        }
        if (prunedEpics.length) {
            dv.el("h2", "🏆 Epics");
            dv.taskList(prunedEpics);
        }
        if (ownInitiatives.length) {
            dv.el("h2", "🎖️ Initiatives");
            dv.taskList(ownInitiatives);
        }
        if (responsibilityTasks.length) {
            dv.el("h2", "📂 Responsibilities");
            dv.taskList(responsibilityTasks);
        }
}
const inactiveProjectView = () => projectView(false);

const deadlineView = (completed = false, taskList = currentTasks, header = "❗ Deadlines") => {
	const hasDeadline = (task) => {
	    if (
		    task.due || 
		    task.scheduled || 
		    /🎯\s*\d{4}-\d{2}-\d{2}/.test(task.text) ||
		    isMarkedCompleted(task)
	    ) {
	        return true;
	    }
	
	    if (task.start) {
	        if (task.due || task.scheduled) {
	            return true;
	        }
	        const today = new Date();
	        today.setHours(0, 0, 0, 0);
	        const startDate = new Date(task.start);
	        startDate.setHours(0, 0, 0, 0);
	        return task.status === " " || startDate >= today;
	    }
	    return false;
	};

	const isTaskAssignedToUser = (task, teamMemberName) => {
		const match = task.text.match(/active-([^\s]+)/);
		return !match || match[1] === teamMemberName;
	};
  
	const getEarliestDate = (task) => {
	    const dateCandidates = [];
	    const nonStartDates = [];
	    if (task.due) nonStartDates.push(task.due);
	    if (task.scheduled) nonStartDates.push(task.scheduled);
	    const targetMatch = task.text.match(/🎯\s*(\d{4}-\d{2}-\d{2})/);
	    if (targetMatch) nonStartDates.push(targetMatch[1]);
	    if (nonStartDates.length > 0) {
	        dateCandidates.push(...nonStartDates);
	    } 
	    else if (task.start) {
	        dateCandidates.push(task.start);
	    }
	    const dateObjects = dateCandidates
	        .map(dateStr => new Date(dateStr))
	        .filter(date => !isNaN(date));
	    if (!dateObjects.length) {
	        return new Date(8640000000000000); 
	    }
	    let earliest = dateObjects[0];
	    for (let i = 1; i < dateObjects.length; i++) {
	        if (dateObjects[i] < earliest) {
	            earliest = dateObjects[i];
	        }
	    }
	    return earliest;
	};

	const getCompletionDate = (task) => {
	    const match = task.text.match(/✅\s(\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01]))/);
	    if (!match) return null;
	    return new Date(match[1]);
	};

	const collectDescendantDeadlineTasks = (task, teamMemberName) => {
		let results = [];
		if (task.children && task.children.length) {
			task.children.forEach(child => {
				if (isTaskAssignedToUser(child, teamMemberName)) {
					if (hasDeadline(child)) {
						results.push({ ...child, children: [], parent: null });
					}
					results = results.concat(collectDescendantDeadlineTasks(child, teamMemberName));
				}
			});
		}
		return results;
	};

	const initialDeadlineTasks = taskList
	    .filter(task => activeForMember(task));

	let allDeadlineTasks = [];
	initialDeadlineTasks.forEach(task => {
		allDeadlineTasks.push({ ...task, children: [], parent: null });
		allDeadlineTasks = allDeadlineTasks.concat(collectDescendantDeadlineTasks(task, teamMemberName));
	});

	const filteredTasks = allDeadlineTasks
        .filter(task => completed ? task.completed : !isCancelled(task) && !isMarkedCompleted(task) && hasDeadline(task))
        .sort((a, b) => completed? getCompletionDate(b) - getCompletionDate(a) : getEarliestDate(a) - getEarliestDate(b));

	if (filteredTasks.length) {
		dv.el("h2", header);
	    dv.taskList(filteredTasks, false);
	}
};
const completedView = () => {
	deadlineView(true, currentTasks, "✅ Completed")
};

