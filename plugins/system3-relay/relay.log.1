    updateView(viewOptions[viewSelect.selectedIndex].render);
});

projectStatusSelect.addEventListener('change', evt => {
    updateView(evt.target.value === "inactive" ? inactiveProjectView : projectView);
});

// INITIAL RENDER
updateView(viewOptions[viewSelect.selectedIndex].render);
